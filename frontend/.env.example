# Base URL of the Sprachweg Spring Boot API used by the browser (inlined at build time).
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8080
# Production:
# NEXT_PUBLIC_API_URL=https://api.course.amanullah.me

# Public URL of this frontend (metadataBase, canonical URLs, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://course.amanullah.me

# Optional: API base URL used only for server-side rendering (e.g. inside Docker: http://backend:8080)
# API_URL_INTERNAL=http://backend:8080
