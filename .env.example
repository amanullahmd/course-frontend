# Copy to .env (git-ignored) next to docker-compose.yml to send real e-mail through Resend instead of Mailpit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=Sprachweg <no-reply@course.amanullah.me>
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
